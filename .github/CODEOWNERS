# Who and what the build trusts: a project's maintainers and their keys, a
# dependency's pinned source, the channel signing keys, and the workflows that publish.
/projects/*/maintainers.yaml @tsaubergine
/projects/*/keys/ @tsaubergine
/dependencies/*/project.yaml @tsaubergine
/keys/ @tsaubergine
/trust/ @tsaubergine
/scripts/ @tsaubergine
/defaults.yaml @tsaubergine
/ci/ @tsaubergine
/.github/ @tsaubergine
