#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CTEST_OUTPUT_ON_FAILURE = ON
export PYBUILD_NAME = dccl5

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)

# char is unsigned on arm64, which the CCL compatibility encoders don't allow
# for (src/ccl/WhoiUtil.cpp), so their test aborts there
ifeq ($(DEB_HOST_ARCH),arm64)
CTEST_ARGS = ARGS+=-E ARGS+=dccl_test_ccl_whoi_util
endif

%:
	dh $@ --buildsystem=cmake

# UDUNITS-2 is used only by protoc-gen-dccl, keeping libdccl free of it.
# ADD_SYMLINKS would write into the source tree.
override_dh_auto_configure:
	dh_auto_configure -- -Denable_udunits=ON -Denable_udunits_runtime=OFF -DADD_SYMLINKS=OFF \
		-Dbuild_doc=$(if $(filter nodoc,$(DEB_BUILD_OPTIONS)),OFF,ON) \
		-Denable_testing=$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),OFF,ON)

# python/setup.py is generated by CMake and links the extension against the libdccl it built
override_dh_auto_build:
	dh_auto_build
	dh_auto_build --buildsystem=pybuild --sourcedirectory=python

override_dh_auto_install:
	dh_auto_install
	dh_auto_install --buildsystem=pybuild --sourcedirectory=python

override_dh_auto_test:
	dh_auto_test -- $(CTEST_ARGS)

override_dh_auto_clean:
	dh_auto_clean
	rm -rf .pybuild python/build python/dccl.egg-info python/setup.py
