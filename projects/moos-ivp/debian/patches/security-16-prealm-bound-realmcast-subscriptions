@@ -289,6 +290,19 @@ void Realm::handleMailRealmCastReq(string sval)
   string client = pipeway.getClient();
 
   if(m_map_pipeways.count(client) == 0) {
+    // Preserve the expiration grace period while there is room, but reclaim
