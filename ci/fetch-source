#!/usr/bin/env bash
# Fetches the upstream source for the version in a project's debian/changelog
# and leaves it in <destdir> as the .orig tarball dpkg-source expects.
#
# Usage: fetch-source [--debian-dir <dir>] [--ref <commit>] <project> <destdir>
#   --debian-dir  read the version from <dir>/changelog (e.g. from stage-debian)
#   --ref         (source: git) fetch this commit instead of the release tag.
#                 Its signature isn't checked here: whoever picks the commit
#                 must have verified it (see continuous.yml).
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
debian_dir=
ref=
while [ $# -gt 0 ]; do
    case "$1" in
        --debian-dir) debian_dir=$2; shift 2 ;;
        --ref) ref=$2; shift 2 ;;
        *) break ;;
    esac
done
project=${1:?usage: fetch-source [--debian-dir <dir>] [--ref <commit>] <project> <destdir>}
destdir=${2:?usage: fetch-source [--debian-dir <dir>] [--ref <commit>] <project> <destdir>}
config="${root}/ci/project-config"
project_dir="${root}/projects/${project}"
debian_dir=${debian_dir:-${project_dir}/debian}

changelog="${debian_dir}/changelog"
source=$(dpkg-parsechangelog -l "${changelog}" -S Source)
version=$(dpkg-parsechangelog -l "${changelog}" -S Version)
upstream_version=${version#*:}
upstream_version=${upstream_version%-*}

mkdir -p "${destdir}"
source_method=$("${config}" "${project}" get source)
if [ -n "${ref}" ] && [ "${source_method}" != git ]; then
    echo "fetch-source: --ref needs source: git, but ${project} uses ${source_method}" >&2
    exit 1
fi
case "${source_method}" in
    uscan)
        # uscan fetches the newest upstream release; pinning a version with
        # --download-version or --download-current-version doesn't match
        # releases renamed by uversionmangle (e.g. +dfsg) on every devscripts
        # version, so the check below catches a newer upstream release.
        uscan --destdir="${destdir}" --verbose "${project_dir}"
        ;;
    git)
        work=$(mktemp -d)
        trap 'rm -rf "${work}"' EXIT
        git init -q "${work}/repo"
        upstream_git=$("${config}" "${project}" get upstream.git)
        if [ -n "${ref}" ]; then
            git -C "${work}/repo" fetch -q --depth 1 "${upstream_git}" "${ref}"
            archive_ref=FETCH_HEAD
        else
            tag=$("${config}" "${project}" release-tag)
            git -C "${work}/repo" fetch -q --depth 1 "${upstream_git}" "refs/tags/${tag}:refs/tags/${tag}"
            if [ "$("${config}" "${project}" get release.require_signed_tag)" = true ]; then
                "${root}/ci/verify-signature" "${project}" "${work}/repo" "refs/tags/${tag}"
            fi
            archive_ref=refs/tags/${tag}
        fi
        git -C "${work}/repo" archive --format=tar --prefix="${source}-${upstream_version}/" "${archive_ref}" \
            | gzip -n > "${work}/${source}-${upstream_version}.tar.gz"
        # mk-origtargz applies debian/copyright's Files-Excluded, as uscan does.
        mk-origtargz --package "${source}" --version "${upstream_version}" --compression gzip --copy \
            --copyright-file "${project_dir}/debian/copyright" --directory "${destdir}" \
            "${work}/${source}-${upstream_version}.tar.gz"
        ;;
esac

shopt -s nullglob
orig=("${destdir}/${source}_${upstream_version}".orig.tar.*)
if [ ${#orig[@]} -eq 0 ]; then
    echo "fetch-source: expected ${source}_${upstream_version}.orig.tar.* in ${destdir}; upstream may have released a newer version than debian/changelog's ${version}" >&2
    exit 1
fi
