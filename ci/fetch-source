#!/usr/bin/env bash
# Fetches the upstream source for the version in a project's debian/changelog
# and leaves it in <destdir> as the .orig tarball dpkg-source expects.
#
# Usage: fetch-source <project> <destdir>
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
project=${1:?usage: fetch-source <project> <destdir>}
destdir=${2:?usage: fetch-source <project> <destdir>}

mkdir -p "${destdir}"
case "$("${root}/ci/project-config" "${project}" get source)" in
    uscan)
        # Pin the changelog's version, or uscan fetches the newest upstream
        # release. Not --download-current-version: that applies the watch
        # file's dversionmangle, so with a uversionmangle (e.g. +dfsg) it
        # never matches.
        version=$(dpkg-parsechangelog -l "${root}/projects/${project}/debian/changelog" -S Version)
        upstream_version=${version#*:}
        upstream_version=${upstream_version%-*}
        uscan --destdir="${destdir}" --download-version "${upstream_version}" --verbose "${root}/projects/${project}"
        ;;
esac
